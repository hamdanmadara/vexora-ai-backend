# =============================================================================
# Vexora AI Backend - Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the real values.
# Never commit `.env` to git.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins.
# 5173 = vite default; 5174 = vite fallback when 5173 is busy;
# 4173 = vite preview server. Add your prod domain here too.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# --- OpenAI ---
# Required for embeddings + all agents
OPENAI_API_KEY=sk-...

# Models (can be changed freely without touching code)
# Use gpt-4o-mini for fast chat; gpt-4o for scheduler if you need stronger booking logic.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Scheduling agent (optional; defaults to OPENAI_CHAT_MODEL)
OPENAI_SCHEDULER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match your embedding model's output dimension
# (text-embedding-3-small = 1536, text-embedding-3-large = 3072)
EMBEDDING_DIMENSIONS=1536

# --- Supabase ---
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# From Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# IMPORTANT: prefer the "Session pooler" or direct connection string.
# The transaction pooler (port 6543) does NOT support prepared statements
# which Mastra and `pg` rely on. Use port 5432 or the session pooler.
SUPABASE_DB_URL=postgres://postgres:your-password@db.xxxx.supabase.co:5432/postgres

# --- Google (for booking Meet) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# After OAuth, this is who the sales rep is — used as the "owner" of bookings.
# Just any stable string for now (single-tenant mode).
DEFAULT_SALES_REP_ID=default
# Sales rep's calendar timezone (working hours 9am–6pm). NOT the customer's zone.
# Customers are asked for their own timezone (US Eastern, Pacific, etc.) in chat.
SALES_TIMEZONE=America/New_York

# --- Knowledge base / RAG ---
KNOWLEDGE_INDEX_NAME=vexora_knowledge
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# --- Company / branding (optional) ---
# The chatbot represents this company to the customer. Leave both blank to
# keep the bot fully generic (it will infer the company from the uploaded
# documents). Set these when you want greetings + CTAs to use your brand.
# Example:
#   COMPANY_NAME=PageVault
#   COMPANY_DESCRIPTION=A secure document storage platform for legal teams.
COMPANY_NAME=
COMPANY_DESCRIPTION=

# --- Zendesk Messaging (Sunshine Conversations) ---
# First non-web channel. All four vars must be set for the /api/channels/zendesk
# webhook to be enabled (otherwise it responds 503 FEATURE_DISABLED).
# CONFIRM the base URL and payload/signature details against your own Zendesk
# Messaging integration (Admin Center -> Channels -> Messaging -> Webhooks)
# before going live — see src/channels/adapters/zendesk/zendesk.types.ts.
ZENDESK_API_BASE_URL=https://api.smooch.io/v2
ZENDESK_APP_ID=
ZENDESK_API_KEY_ID=
ZENDESK_API_KEY_SECRET=
ZENDESK_WEBHOOK_SECRET=

# ============================================================================
# Auth (multi-user)
# ============================================================================
# HMAC secret for access tokens + OAuth state. Long and random; rotating it
# signs everyone out. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access-token lifetime in minutes (default 60) and refresh lifetime in days (default 30).
# JWT_ACCESS_TTL_MIN=60
# JWT_REFRESH_TTL_DAYS=30

# Which user's workspace the env-configured Zendesk integration belongs to
# (a users.id uuid). Unset = legacy 'default' tenant.
# ZENDESK_TENANT_ID=
